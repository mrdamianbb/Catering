# Wzór pliku ze zmiennymi. Prawdziwe wartości wpisuje się w Vercelu,
# w ustawieniach projektu, w sekcji Environment Variables.
# Tego pliku nie wypełniamy własnymi kluczami — trafia do repozytorium.

# ── Baza danych (Supabase) ──
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=klucz_publiczny
SUPABASE_SERVICE_ROLE_KEY=klucz_serwisowy_nigdy_do_repozytorium

# ── SMS (SMSAPI) ──
SMSAPI_TOKEN=token_z_panelu_smsapi
SMSAPI_ADMIN_PHONE=48XXXXXXXXX

# ── Płatności (Przelewy24) ──
P24_MERCHANT_ID=415212
P24_POS_ID=415212
P24_API_KEY=klucz_do_api_z_panelu_p24
P24_CRC=klucz_crc_z_panelu_p24
P24_SANDBOX=true

# ── Opcjonalne ──
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SITE_URL=https://dzikakaczkacatering.pl
